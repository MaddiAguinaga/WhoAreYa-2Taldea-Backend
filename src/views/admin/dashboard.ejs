<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin Dashboard</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f6f8;
            padding: 30px;
        }

        h1 {
            margin: 0;
        }

        /* ===== LAYOUT ===== */
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .top-actions {
            display: flex;
            gap: 10px;
        }

        /* ===== BUTTONS ===== */
        .btn {
            padding: 8px 14px;
            border-radius: 4px;
            border: none;
            cursor: pointer;
            font-weight: bold;
            text-decoration: none;
            display: inline-block;
        }

        .btn-primary {
            background-color: #007bff;
            color: white;
        }

        .btn-primary:hover {
            background-color: #0069d9;
        }

        .btn-danger {
            background-color: #dc3545;
            color: white;
        }

        .btn-danger:hover {
            background-color: #c82333;
        }

        .btn-secondary {
            background-color: #6c757d;
            color: white;
        }

        .btn-secondary:hover {
            background-color: #5a6268;
        }

        /* ===== ALERTS ===== */
        .alert {
            padding: 14px;
            margin-bottom: 25px;
            border-radius: 4px;
            font-weight: bold;
        }

        .alert.success {
            background-color: #d4edda;
            color: #155724;
            border-left: 5px solid #28a745;
        }

        /* ===== TABLE ===== */
        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        }

        th, td {
            padding: 12px;
            border-bottom: 1px solid #ddd;
            text-align: left;
        }

        th {
            background-color: #f1f1f1;
            font-size: 14px;
            text-transform: uppercase;
        }

        tr:hover {
            background-color: #f9f9f9;
        }

        .actions {
            display: flex;
            gap: 8px;
        }

        form {
            display: inline;
        }

        .empty {
            text-align: center;
            font-style: italic;
            color: #666;
        }
    </style>
</head>
<body>

<div class="container">

    <!-- ===== CONFIRMATION MESSAGE ===== -->
    <% if (success) { %>
        <div class="alert success">
            <% if (success === "player_created") { %>
                Player successfully created.
            <% } else if (success === "player_updated") { %>
                Player successfully updated.
            <% } else if (success === "player_deleted") { %>
                Player successfully deleted.
            <% } %>
        </div>
    <% } %>

    <!-- ===== TOP BAR ===== -->
    <div class="top-bar">
        <h1>Admin Dashboard</h1>

        <div class="top-actions">
            <a href="/admin/players/new" class="btn btn-primary">+ New Player</a>
            <a href="/admin/logout" class="btn btn-secondary">Logout</a>
        </div>
    </div>

    <!-- ===== TABLE ===== -->
    <table>
        <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Nationality</th>
            <th>Position</th>
            <th>Number</th>
            <th>Team ID</th>
            <th>League ID</th>
            <th>Actions</th>
        </tr>
        </thead>

        <tbody>
        <% if (players.length === 0) { %>
            <tr>
                <td colspan="8" class="empty">No players found</td>
            </tr>
        <% } else { %>
            <% players.forEach(player => { %>
                <tr>
                    <td><%= player.id %></td>
                    <td><%= player.name %></td>
                    <td><%= player.nationality || "-" %></td>
                    <td><%= player.position %></td>
                    <td><%= player.number %></td>
                    <td><%= player.teamId %></td>
                    <td><%= player.leagueId %></td>
                    <td>
                        <div class="actions">
                            <a
                                    href="/admin/players/edit/<%= player.id %>"
                                    class="btn btn-primary"
                            >
                                Edit
                            </a>

                            <form
                                    method="POST"
                                    action="/admin/players/delete/<%= player.id %>"
                                    onsubmit="return confirm('Ziur zaude jokalaria ezabatu nahi duzula? Ekintza hau ezin da atzera bota.');"
                            >
                                <button type="submit" class="btn btn-danger">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            <% }) %>
        <% } %>
        </tbody>
    </table>

</div>

</body>
</html>
